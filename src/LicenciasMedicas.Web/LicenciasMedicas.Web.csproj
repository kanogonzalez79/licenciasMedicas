<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\LicenciasMedicas.Core\LicenciasMedicas.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      net8.0-windows + UseWindowsForms: necesario para mostrar el diálogo nativo
      "Buscar carpeta" de Windows al respaldar (ver design.md de respaldar-datos).
      La app ya es Windows-only (self-contained win-x64, Process.Start de la UI),
      así que esto no reduce la compatibilidad real.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Publicación en un solo .exe (dotnet publish -c Release): todo el runtime de .NET,
    dependencias y librerías nativas (ej. e_sqlite3.dll) quedan embebidos, así que la
    carpeta de salida no tiene DLLs sueltos - solo el exe, y afuera las carpetas
    data/logs que crea AppPaths en runtime.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <!--
    appsettings*.json son opcionales para ASP.NET Core (AddJsonFile(..., optional: true));
    sin ellos la app usa los defaults ya fijados en código (Program.cs, AppPaths). Se excluyen
    solo de Release para que la publicación quede con únicamente el .exe; en Debug (dotnet run)
    se siguen copiando al bin de salida como siempre.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Update="appsettings.json;appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    Residuos que el SDK sigue copiando en publish self-contained sin que haya una propiedad
    MSBuild que los suprima: createdump.exe (herramienta de diagnóstico de crashes) y
    web.config (solo sirve para hosting en IIS; esta app se autohospeda en Kestrel). Se borran
    a mano después de publicar para que la carpeta quede con únicamente el .exe.
  -->
  <!--
    AfterTargets="Publish" no alcanza: el SDK genera web.config en _TransformWebConfig,
    que corre DESPUÉS de "Publish" (vía _AspNetCoreProjectSystemPostPublish -> _DotNetCLIPostPublish,
    ver Microsoft.NET.Sdk.Publish.targets). Hay que engancharse después de ese último target.
  -->
  <Target Name="RemovePublishExtras" AfterTargets="_DotNetCLIPostPublish">
    <ItemGroup>
      <_PublishExtrasToRemove Include="$(PublishDir)createdump.exe;$(PublishDir)web.config" />
    </ItemGroup>
    <Delete Files="@(_PublishExtrasToRemove)" Condition="Exists('%(_PublishExtrasToRemove.Identity)')" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
    <Content Remove="wwwroot\**\*" />
  </ItemGroup>

  <!--
    Compila el cliente React (LicenciasMedicas.Web.Client) y lo embebe como si viviera
    en wwwroot, sin copiarlo físicamente. Solo corre en Release (dotnet publish): en Debug
    (F5 / dotnet run) el ciclo de desarrollo usa `npm run dev` con proxy a este backend,
    ver Web.Client/vite.config.ts.

    El ItemGroup va DENTRO del target (no como ItemGroup suelto del proyecto) a propósito:
    un ItemGroup suelto se evalúa al cargar el proyecto, antes de que "npm run build" haya
    generado dist/, así que un glob ahí no vería nada en un checkout limpio. Agregarlo
    dentro del target, ejecutado BeforeTargets="BeforeBuild", asegura que los archivos ya
    existan cuando se agregan como EmbeddedResource. Mecanismo Link validado en la tarea 1.1.
  -->
  <Target Name="BuildClientAssets" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="npm ci" WorkingDirectory="..\LicenciasMedicas.Web.Client" />
    <Exec Command="npm run build" WorkingDirectory="..\LicenciasMedicas.Web.Client" />
    <ItemGroup>
      <_ClientDistFiles Include="..\LicenciasMedicas.Web.Client\dist\**\*" />
    </ItemGroup>
    <ItemGroup>
      <!--
        %(RecursiveDir) no se calcula para items creados dentro de un Target (solo funciona
        para ItemGroup estáticos evaluados al cargar el proyecto) - por eso se arma el Link
        con GetRelativePath en vez de depender de esa metadata. Ver nota de la tarea 6.1.
      -->
      <EmbeddedResource Include="@(_ClientDistFiles)">
        <Link>wwwroot\$([System.IO.Path]::GetRelativePath('$(MSBuildProjectDirectory)\..\LicenciasMedicas.Web.Client\dist', '%(FullPath)'))</Link>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
